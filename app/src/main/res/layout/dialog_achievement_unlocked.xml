<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/unlocked_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/achievement_unlocked_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/unlocked_icon"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/cd_achievement_icon"
            android:scaleType="fitCenter"
            tools:src="@drawable/ach25b" />

        <TextView
            android:id="@+id/unlocked_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            tools:text="50 Baptisms" />

        <TextView
            android:id="@+id/unlocked_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="50 baptisms performed" />

        <TextView
            android:id="@+id/unlocked_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:text="at Salt Lake Temple"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/unlocked_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            tools:text="on January 15, 2025"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/unlocked_index"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            tools:text="Achievement 1 of 2"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/unlocked_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:text="Posted!" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unlocked_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unlocked_post"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/post_to_celebration_board"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
